[Unit]
Description=Leadpoet gateway liveness watchdog (one check)
Documentation=file:///home/ec2-user/leadpoet_repo/docs/gateway_liveness_watchdog.md
After=network-online.target

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
# A recovery runs gw_restart.sh, which can take several minutes. The watchdog
# takes its own flock, so an overlapping timer firing is a no-op rather than a
# second restart.
TimeoutStartSec=3600
ExecStart=/home/ec2-user/leadpoet_repo/scripts/gateway_liveness_watchdog.sh
