[Unit]
# Generated by gw_restart.sh from config/systemd/leadpoet-gateway.service in
# the deployed tree, and reinstalled on every release, so the installed unit
# always matches the code that is running. Edit the template in the repository,
# not this file: local changes are overwritten by the next deploy.
Description=Leadpoet gateway (gateway.main)
Documentation=file://@LEADPOET_REPO_ROOT@/docs/gateway_supervision.md
After=network-online.target
Wants=network-online.target
# Never stop retrying. A gateway that systemd has given up on is a gateway that
# stays dead until a human notices, which is the failure this unit exists to
# remove. RestartSec bounds how hard a crashloop hits the host.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@GATEWAY_RUN_USER@
WorkingDirectory=@LEADPOET_REPO_ROOT@
Environment=GATEWAY_SUPERVISED_LAUNCH_ENV=@GATEWAY_SUPERVISOR_LAUNCH_ENV@
ExecStart=@LEADPOET_REPO_ROOT@/scripts/gateway_supervised_launch.sh
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
# The launcher redirects the gateway's own output into GATEWAY_LOG_FILE before
# it execs, so the journal carries only the launcher's pre-exec failures --
# exactly what `journalctl -u leadpoet-gateway` should show when a restart is
# not taking.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
