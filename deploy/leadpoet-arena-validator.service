[Unit]
Description=Leadpoet normal Arena validator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ec2-user/leadpoet/validator-current
EnvironmentFile=/home/ec2-user/.config/leadpoet/arena-validator-runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/python3 scripts/run_arena_validator.py --environment-file /home/ec2-user/.config/leadpoet/arena-validator-service.env --enclave-cid ${ENCLAVE_CID} --check-only
ExecStart=/usr/bin/python3 scripts/run_arena_validator.py --environment-file /home/ec2-user/.config/leadpoet/arena-validator-service.env --enclave-cid ${ENCLAVE_CID}
Restart=on-failure
RestartSec=15
KillSignal=SIGTERM
KillMode=mixed
# Allow current model/scoring leases to finish. New claims stop on SIGTERM.
TimeoutStopSec=9300
UMask=0077

[Install]
WantedBy=multi-user.target
