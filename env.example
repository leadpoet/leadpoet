# =============================================================================
# FOR VALIDATORS ONLY
# =============================================================================
# Copy this file to .env and fill in your API keys

# =============================================================================
# Network Configuration
# =============================================================================
SUBTENSOR_NETWORK=finney

# =============================================================================
# Supabase (REQUIRED)
# =============================================================================
SUPABASE_URL=https://qplwoislplkcegvdmbim.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# Sourcing Validation APIs (REQUIRED)
# =============================================================================

# TrueList - Email verification (Stage 3)
# https://truelist.io/
TRUELIST_API_KEY=your_truelist_api_key_here

# ScrapingDog - LinkedIn/Google Search validation (Stage 4 & 5)
# https://www.scrapingdog.com/
SCRAPINGDOG_API_KEY=your_scrapingdog_api_key_here

# OpenRouter - LLM inference for scoring
# https://openrouter.ai/
OPENROUTER_KEY=your_openrouter_key_here

# =============================================================================
# Qualification APIs (REQUIRED for model evaluation)
# =============================================================================
# These are SEPARATE keys from sourcing — used only for qualification
# model evaluation. Keeps billing and rate limits isolated.

QUALIFICATION_SCRAPINGDOG_API_KEY=your_qualification_scrapingdog_key_here
QUALIFICATION_OPENROUTER_API_KEY=your_qualification_openrouter_key_here

# Qualification leads table (set by deployment scripts)
QUALIFICATION_LEADS_TABLE=test_leads_for_miners

# =============================================================================
# Reputation Score APIs (OPTIONAL)
# =============================================================================
# Most reputation checks use free public APIs (no key needed):
# - Wayback Machine
# - SEC EDGAR
# - GDELT
# - WHOIS/DNSBL
#
# Optional paid APIs for enhanced reputation scoring:
COMPANIES_HOUSE_API_KEY=your_companies_house_key_here

# =============================================================================
# Research Lab providers (OPTIONAL)
# =============================================================================
# RESEARCH_LAB_PROVIDER_REGISTRY_PATH=/path/to/provider_registry.json
# RESEARCH_LAB_PROVIDER_USAGE_LEDGER_PATH=/var/lib/research-lab/provider_usage.jsonl
# RESEARCH_LAB_PROVIDER_KEY_SPLIT=true
# RESEARCH_LAB_EXA_API_KEY=lab-scoped-key
# RESEARCH_LAB_SCRAPINGDOG_API_KEY=lab-scoped-key
# RESEARCH_LAB_OPENROUTER_API_KEY=lab-scoped-key
# RESEARCH_LAB_PROXY_CALLER_CONTEXT={"caller_kind":"benchmark","worker":"w0"}
# RESEARCH_LAB_PROXY_CALLER_TOKEN_MAP=/var/lib/research-lab/proxy_caller_tokens.json

# =============================================================================
# Error monitoring — Sentry (OPTIONAL, host processes only)
# =============================================================================
# Fail-closed error capture for crashes and ERROR-level logs across the
# gateway, validator, miner, and Research Lab worker processes.
# It never captures trajectory/training data or contact data: protected
# surfaces (research_lab, gateway.research_lab, qualification,
# model code, LLM clients) keep only exception type + stack; stack locals,
# source context lines, request bodies, and argv never leave the process.
# See docs/sentry_error_monitoring.md. Inert unless BOTH gate variables are
# set. NEVER set these inside an attested enclave.
# LEADPOET_SENTRY_ENABLED=true
# LEADPOET_SENTRY_DSN=your_sentry_dsn_here
# Optional overrides: environment label (default "production"), release
# (default: exact deploy SHA, then current git HEAD), extra protected module prefixes (comma
# separated — can only widen redaction), and message mode
# ("scrub" default | "redact-all" for maximum privacy).
# LEADPOET_SENTRY_ENVIRONMENT=production
# LEADPOET_SENTRY_RELEASE=
# LEADPOET_SENTRY_EXTRA_PROTECTED_MODULES=
# LEADPOET_SENTRY_MESSAGE_MODE=scrub

# Optional future Arena contact rounds. Install migration 215 and matching images first.
# Activation applies to submission-open time and also requires LAB_ARENA_INTEGRITY_FROM.
# LAB_ARENA_CONTACTS_FROM=2026-10-01T00:00:00Z
# LAB_ARENA_CONTACTS_GENERATION_ENABLED=true

# Optional future company-quality rounds. Install the company-judgment migration
# and matching gateway/validator/scorer images before selecting an intake time.
# Requires LAB_ARENA_INTEGRITY_FROM; existing open/frozen rounds never change.
# LAB_ARENA_COMPANY_QUALITY_FROM=2026-10-01T00:00:00Z
