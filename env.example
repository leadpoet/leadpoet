# =============================================================================
# Gateway and Arena example settings
# =============================================================================
# Copy this file to .env and fill in your API keys

# =============================================================================
# Network Configuration
# =============================================================================
BITTENSOR_NETWORK=finney
BITTENSOR_NETUID=71

# =============================================================================
# Supabase (REQUIRED)
# =============================================================================
SUPABASE_URL=https://qplwoislplkcegvdmbim.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# OpenRouter creates the private daily ICP set. Arena provider credentials use
# LAB_ARENA_* settings in the protected production environment.
OPENROUTER_API_KEY=your_openrouter_key_here

# =============================================================================
# Error monitoring — Sentry (OPTIONAL, host processes only)
# =============================================================================
# Fail-closed error capture for crashes and ERROR-level logs across the
# gateway and Arena service and validator processes.
# It never captures trajectory/training data or contact data: protected
# surfaces (qualification, model code, and LLM clients) keep only exception
# type + stack; stack locals,
# source context lines, request bodies, and argv never leave the process.
# See docs/sentry_error_monitoring.md. Inert unless BOTH gate variables are
# set. NEVER set these inside an attested enclave.
# LEADPOET_SENTRY_ENABLED=true
# LEADPOET_SENTRY_DSN=your_sentry_dsn_here
# Optional overrides: environment label (default "production"), release
# (default: exact deploy SHA, then current git HEAD), extra protected module prefixes (comma
# separated — can only widen redaction), and message mode
# ("scrub" default | "redact-all" for maximum privacy).
# LEADPOET_SENTRY_ENVIRONMENT=production
# LEADPOET_SENTRY_RELEASE=
# LEADPOET_SENTRY_EXTRA_PROTECTED_MODULES=
# LEADPOET_SENTRY_MESSAGE_MODE=scrub

# Optional future Arena contact rounds. Install migration 215 and matching images first.
# Activation applies to submission-open time and also requires LAB_ARENA_INTEGRITY_FROM.
# LAB_ARENA_CONTACTS_FROM=2026-10-01T00:00:00Z
# LAB_ARENA_CONTACTS_GENERATION_ENABLED=true

# Optional future company-quality rounds. Install the company-judgment migration
# and matching gateway/validator/scorer images before selecting an intake time.
# Requires LAB_ARENA_INTEGRITY_FROM; existing open/frozen rounds never change.
# LAB_ARENA_COMPANY_QUALITY_FROM=2026-10-01T00:00:00Z
