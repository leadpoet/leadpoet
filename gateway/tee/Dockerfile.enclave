FROM python:3.9.24-slim-bookworm@sha256:9b89d7e0d7e84de70c5e441198fdccb25b8d38310b0ccde36dbcd79a175fc1d9

# Docker BuildKit consumes this predefined build argument when normalizing
# image/layer creation timestamps. The value is also exported below for tools.
ARG SOURCE_DATE_EPOCH=0
ARG LEADPOET_ENCLAVE_ROLE=gateway_coordinator

# The exact x86_64 base manifest and all wheels are immutable inputs to
# independent PCR0 rebuilds.
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONHASHSEED=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
ENV LEADPOET_ENCLAVE_ROLE=${LEADPOET_ENCLAVE_ROLE}
ENV PYTHONPATH=/app:/app/gateway/_attested_runtime

# Install the exact identity-enclave dependency closure from the offline wheelhouse.
COPY _enclave_source/tee/requirements-enclave-py39.in /tmp/requirements-enclave-py39.in
COPY _enclave_source/tee/requirements-enclave-py39.lock /tmp/requirements-enclave-py39.lock
COPY _enclave_source/tee/enclave_wheelhouse.py /tmp/enclave_wheelhouse.py
COPY _enclave_source/tee/wheelhouse/ /tmp/wheelhouse/
RUN python3 /tmp/enclave_wheelhouse.py verify-wheelhouse \
        --input /tmp/requirements-enclave-py39.in \
        --lock /tmp/requirements-enclave-py39.lock \
        --wheelhouse /tmp/wheelhouse \
    && python3 -m pip install --no-index --find-links=/tmp/wheelhouse --no-deps --no-cache-dir --no-compile --require-hashes -r /tmp/requirements-enclave-py39.lock \
    && python3 /tmp/enclave_wheelhouse.py verify-installed \
        --lock /tmp/requirements-enclave-py39.lock \
    && (find /usr -type f \( -name "*.pyc" -o -name "*.pyo" \) -delete 2>/dev/null || true) \
    && (find /usr -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true) \
    && (find /usr -exec touch -h -d @0 {} + 2>/dev/null || true) \
    && rm -rf /tmp/wheelhouse /tmp/requirements-enclave-py39.in \
        /tmp/requirements-enclave-py39.lock /tmp/enclave_wheelhouse.py

# Set working directory
WORKDIR /app

# Copy ENTIRE gateway directory for code_hash verification
# Build context must be gateway root, not tee/ subdirectory
COPY _enclave_source/ /app/gateway/
RUN test -d /app/gateway/_attested_runtime/leadpoet_canonical

RUN python3 /app/gateway/tee/scoring_import_closure.py verify-staged \
    --gateway-root /app/gateway \
    --role "${LEADPOET_ENCLAVE_ROLE}"
RUN python3 /app/gateway/tee/protected_workflows.py \
    --root /app/gateway \
    --manifest /app/gateway/tee/protected_workflows.json
RUN python3 /app/gateway/tee/topology.py \
    --verify /app/gateway/tee/topology.json
RUN test -f "/app/gateway/_attested_runtime/gateway_enclave_build_identities/${LEADPOET_ENCLAVE_ROLE}.json" \
    && cp "/app/gateway/_attested_runtime/gateway_enclave_build_identities/${LEADPOET_ENCLAVE_ROLE}.json" \
        /app/gateway/_attested_runtime/gateway_enclave_build_identity.json
RUN python3 /app/gateway/tee/build_identity.py verify \
    --gateway-root /app/gateway \
    --role "${LEADPOET_ENCLAVE_ROLE}"
RUN python3 -c "import cbor2, cryptography; import gateway.tee.tee_service; import leadpoet_canonical.attested_v2"
# Create keys directory
RUN mkdir -p /app/gateway/keys

# Run the TEE service
# -u flag: unbuffered output (CRITICAL for debugging - shows prints immediately)
# Absolute interpreter path: the EIF conversion of this reproducible image
# does not carry the image PATH into the enclave init, so a bare "python3"
# fails execvpe at boot. tee_service bootstraps sys.path itself.
ENTRYPOINT ["/usr/local/bin/python3", "-u", "/app/gateway/tee/tee_service.py"]
