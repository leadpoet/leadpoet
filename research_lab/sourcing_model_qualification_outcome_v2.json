{
  "protocol_id": "sourcing-model.qualification-outcome",
  "protocol_major": 2,
  "result_schema_version": "sourcing-model.qualification-outcome.v2",
  "route_completion_receipt_schema_version": "sourcing-model.route-completion-receipt.v1",
  "metadata_core_fields": [
    "protocol_id",
    "major",
    "minor",
    "entrypoint",
    "result_schema_version",
    "route_completion_receipt_schema_version",
    "contract_sha256",
    "capabilities",
    "probe",
    "extensions"
  ],
  "envelope_core_fields": [
    "schema_version",
    "protocol_major",
    "protocol_minor",
    "contract_sha256",
    "completion_state",
    "companies",
    "route_completion_receipt",
    "extensions"
  ],
  "receipt_core_fields": [
    "schema_version",
    "contract_sha256",
    "outcome_authority",
    "completion_state",
    "disposition",
    "retryable",
    "partial",
    "returned_count",
    "invocation_sha256",
    "route_summary",
    "failure_classes",
    "probe",
    "extensions",
    "receipt_sha256"
  ],
  "required_capabilities": [
    "complete_confirmed_empty",
    "consumer_nonce_probe",
    "incomplete_retryable",
    "model_owned_route_completion_receipt",
    "partial_companies_on_incomplete"
  ],
  "completion_states": [
    "complete",
    "incomplete"
  ],
  "dispositions": [
    "complete_confirmed_empty",
    "complete_nonempty",
    "incomplete_retryable",
    "incomplete_terminal"
  ],
  "route_summary_fields": [
    "attempted",
    "completed",
    "confirmed_empty",
    "retryable_failed",
    "terminal_failed",
    "skipped",
    "retried"
  ],
  "reconciliation": [
    "attempted=completed+confirmed_empty+retryable_failed+terminal_failed",
    "returned_count=len(companies)",
    "partial=(completion_state=incomplete and returned_count>0)"
  ],
  "completion_rules": {
    "complete_nonempty": {
      "completion_state": "complete",
      "minimum_returned_count": 1,
      "retryable": false,
      "failure_classes_count": 0,
      "retryable_failed": 0,
      "terminal_failed": 0
    },
    "complete_confirmed_empty": {
      "completion_state": "complete",
      "returned_count": 0,
      "minimum_confirmed_empty": 1,
      "retryable": false,
      "failure_classes_count": 0,
      "retryable_failed": 0,
      "terminal_failed": 0,
      "host_transport_join_required": true
    },
    "incomplete_retryable": {
      "completion_state": "incomplete",
      "retryable": true,
      "minimum_retryable_failed": 1,
      "minimum_failure_classes_count": 1
    },
    "incomplete_terminal": {
      "completion_state": "incomplete",
      "retryable": false,
      "minimum_terminal_failed": 1,
      "minimum_failure_classes_count": 1
    },
    "unreceipted_empty_allowed": false,
    "qualified_companies_only": true
  },
  "probe": {
    "schema_version": "sourcing-model.qualification-outcome-probe.v1",
    "mode": "consumer_qualification_protocol_probe",
    "nonce_regex": "^[A-Za-z0-9._:-]{16,128}$",
    "nonce_output": "sha256_only",
    "required_cases": {
      "complete_confirmed_empty": {
        "completion_state": "complete",
        "disposition": "complete_confirmed_empty",
        "retryable": false,
        "returned_count": 0,
        "route_summary": {
          "attempted": 1,
          "completed": 0,
          "confirmed_empty": 1,
          "retryable_failed": 0,
          "terminal_failed": 0,
          "skipped": 0,
          "retried": 0
        },
        "failure_classes": []
      },
      "incomplete_retryable": {
        "completion_state": "incomplete",
        "disposition": "incomplete_retryable",
        "retryable": true,
        "returned_count": 0,
        "route_summary": {
          "attempted": 1,
          "completed": 0,
          "confirmed_empty": 0,
          "retryable_failed": 1,
          "terminal_failed": 0,
          "skipped": 0,
          "retried": 0
        },
        "failure_classes": [
          "retryable_provider"
        ]
      }
    }
  },
  "hash_rules": {
    "algorithm": "sha256",
    "encoding": "utf-8",
    "canonical_json": {
      "sort_keys": true,
      "separators": [
        ",",
        ":"
      ],
      "ensure_ascii": false,
      "allow_nan": false
    },
    "receipt_hash_excludes_only": "receipt_sha256"
  },
  "failure_class_policy": {
    "regex": "^[a-z][a-z0-9_.-]{0,79}$",
    "maximum_count": 16,
    "maximum_length": 80,
    "unknown_provider_failure_class": "transport_invariant_failed"
  },
  "extension_evolution": {
    "core_extensions_field_required": true,
    "reverse_dns_keys_only": true,
    "maximum_entries": 8,
    "maximum_canonical_bytes": 32768,
    "maximum_nesting_depth": 3,
    "maximum_array_items": 256,
    "maximum_object_entries": 32,
    "maximum_token_characters": 128,
    "maximum_field_name_characters": 64,
    "maximum_reverse_dns_segment_characters": 32,
    "additive_optional_extensions_same_major": true,
    "additive_optional_capabilities_same_major": true
  },
  "required_route_commitments": {
    "extension_key": "com.leadpoet.required-route-commitments",
    "maximum_count": 256,
    "value_regex": "^[0-9a-f]{64}$",
    "sorted_unique": true,
    "semantic_unit": "logical_obligation",
    "production_required": true,
    "probe_exempt": true
  },
  "production_complete_authority": "model_semantics_joined_to_every_required_commitment_host_observed_latest_successful_terminal",
  "production_confirmed_empty_authority": "model_semantics_joined_to_every_required_commitment_host_observed_latest_successful_terminal"
}
