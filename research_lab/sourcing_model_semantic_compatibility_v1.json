  "runtime_invariants": {
    "schema_version": "leadpoet.sourcing-model-runtime-invariants.v1",
    "adapter_dependencies": {
      "build_query": {
        "icp": {"industry": "Consumer Probe", "geography": "United States"},
        "source": "news"
      },
      "flow_modes": ["branch", "legacy"]
    },
    "company_fit": {
      "identity": {
        "contract_id": "company-fit-decision:v1",
        "outcomes": ["match", "mismatch", "unavailable"],
        "precedence": ["mismatch", "unavailable", "match"],
        "passing_outcome": "match",
        "required_dimensions": ["identity", "employee_size", "industry", "geography"],
        "conditional_dimensions": ["stage"]
      },
      "strict_boolean_cases": [
        {"case_id": "true", "input": true, "expected": true},
        {"case_id": "false", "input": false, "expected": false},
        {"case_id": "string_false", "input": "false", "expected": null},
        {"case_id": "integer_one", "input": 1, "expected": null},
        {"case_id": "none", "input": null, "expected": null}
      ],
      "reconcile_cases": [
        {"case_id": "empty", "decisions": [], "expected": "unavailable"},
        {"case_id": "all_match", "decisions": ["match", "match"], "expected": "match"},
        {"case_id": "unavailable", "decisions": ["match", "unavailable"], "expected": "unavailable"},
        {"case_id": "unknown", "decisions": ["match", "future"], "expected": "unavailable"},
        {"case_id": "mismatch", "decisions": ["match", "mismatch"], "expected": "mismatch"},
        {"case_id": "mixed_nonstring", "decisions": ["match", 1], "expected": "unavailable"}
      ],
      "aggregate_cases": [
        {"case_id": "empty", "decisions": {}, "stage_required": false, "expected": "unavailable"},
        {"case_id": "complete", "decisions": {"identity": "match", "employee_size": "match", "industry": "match", "geography": "match"}, "stage_required": false, "expected": "match"},
        {"case_id": "missing", "decisions": {"identity": "match", "industry": "match"}, "stage_required": false, "expected": "unavailable"},
        {"case_id": "unknown_extra", "decisions": {"identity": "match", "employee_size": "match", "industry": "match", "geography": "match", "invented": "match"}, "stage_required": false, "expected": "unavailable"},
        {"case_id": "mismatch_wins", "decisions": {"identity": "unavailable", "industry": "mismatch"}, "stage_required": false, "expected": "mismatch"},
        {"case_id": "stage_optional", "decisions": {"identity": "match", "employee_size": "match", "industry": "match", "geography": "match", "stage": "unavailable"}, "stage_required": false, "expected": "match"},
        {"case_id": "stage_required_missing", "decisions": {"identity": "match", "employee_size": "match", "industry": "match", "geography": "match"}, "stage_required": true, "expected": "unavailable"},
        {"case_id": "stage_required_match", "decisions": {"identity": "match", "employee_size": "match", "industry": "match", "geography": "match", "stage": "match"}, "stage_required": true, "expected": "match"},
        {"case_id": "stage_required_mismatch", "decisions": {"identity": "match", "employee_size": "match", "industry": "match", "geography": "match", "stage": "mismatch"}, "stage_required": true, "expected": "mismatch"}
      ]
    },
    "runtime_capabilities": {
      "contract_version": "sourcing-model-runtime-capabilities:v2",
      "names": ["deadline", "emit", "http_fetch", "probe_origin", "resolve_host"],
      "host_resolution": {"TIMEOUT": "timeout", "NXDOMAIN": "nxdomain"},
      "origin_reachability": {"UNKNOWN": "unknown", "REACHABLE": "reachable"},
      "sentinel": {
        "deadline": 123.5,
        "http_url": "https://invalid.example/probe",
        "http_timeout": 1.25,
        "http_max_bytes": 7,
        "http_accept": "application/json",
        "emit_event": {"probe": "event"},
        "resolve_input": "transient.invalid",
        "probe_input": "origin.invalid"
      }
    }
