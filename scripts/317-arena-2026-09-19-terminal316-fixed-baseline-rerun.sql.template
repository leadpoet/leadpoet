  'source_sha256','__NEW_SOURCE_SHA256__','source_commit','__NEW_SOURCE_COMMIT__');
 SELECT pg_catalog.jsonb_agg(CASE WHEN item->>'submission_id'='baseline-2026-09-19'
   THEN item||pg_catalog.jsonb_build_object('source_ref','__NEW_SOURCE_REF__',
    'source_size_bytes',__NEW_SOURCE_SIZE_BYTES__) ELSE item END ORDER BY ordinal)
