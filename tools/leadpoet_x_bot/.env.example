# Shell-compatible and systemd EnvironmentFile-compatible. No export prefix.
X_API_KEY=''
X_API_SECRET=''
X_ACCESS_TOKEN=''
X_ACCESS_TOKEN_SECRET=''
# Comma-separated full links to your own root posts.
MONITORED_POST_URLS='https://x.com/YOUR_HANDLE/status/1234567890123456789'
TRIGGER_WORD='Poet'
TRIGGER_ALIASES='peot,poett,poeet,poat,poer,poey'
REPLY_TEXT='Sending!'
# Omit DM_MESSAGE for the exact Leadpoet CTA and updated booking link.
DM_UNAVAILABLE_REPLY='sending, please open your Dms!'
POLL_INTERVAL_SECONDS=300
DRY_RUN=true
STATE_DB='/var/lib/leadpoet-x-bot/state.sqlite3'
# Comma-separated X user IDs for people who opt out.
DENIED_USER_IDS=''
